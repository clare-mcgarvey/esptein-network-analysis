count(state, county, agency_scope, sort = TRUE)
atlas_clean |>
filter(lea_type %in% c("District Attorney", "Prosecutor's Office", "Prosecutor")) |>
distinct(agency, county, state) |>
arrange(state, county) |>
print(n = 40)
problem_types <- c("State Police/Highway Patrol", "State Police", "State Patrol",
"State-Local Partnership", "State Agency", "Attorney General",
"Fusion Center", "Customs And Border Protection", "Fish And Game",
"Fish And Wildlife", "Natural Resources", "Conservation",
"Homeland Security", "Federal Agency", "Drug Enforcement",
"Forest Service", "Treasury/Finance", "Taxation", "Multi-Jurisdiction")
atlas_clean |>
summarise(
n_total = n(),
n_problematic = sum(lea_type %in% problem_types),
pct_problematic = scales::percent(n_problematic / n_total, accuracy = 0.1)
)
# ── Step 1: Define the problematic agency types (jurisdiction exceeds county level) ──
problem_types <- c("State Police/Highway Patrol", "State Police", "State Patrol",
"State-Local Partnership", "State Agency", "Attorney General",
"Fusion Center", "Customs And Border Protection", "Fish And Game",
"Fish And Wildlife", "Natural Resources", "Conservation",
"Homeland Security", "Federal Agency", "Drug Enforcement",
"Forest Service", "Treasury/Finance", "Taxation", "Multi-Jurisdiction")
atlas_clean |>
summarise(
n_total = n(),
n_problematic = sum(lea_type %in% problem_types),
pct_problematic = scales::percent(n_problematic / n_total, accuracy = 0.1)
)
# ── Step 2: Rebuild the score, excluding these agency types ──
atlas_clean_excl <- atlas_clean |>
filter(!lea_type %in% problem_types)
atlas_county_excl <- atlas_clean_excl |>
mutate(
county_clean = str_to_title(
str_remove(county,
regex(" County$| Parish$| Borough$| City And Borough$| Census Area$| Municipality$| Municipio$| Municipality County$| Islands?$",
ignore_case = TRUE))
)
) |>
left_join(fips_xwalk, by = c("state" = "state_name", "county_clean" = "county_name")) |>
left_join(tech_weights, by = "technology") |>
mutate(weight = replace_na(weight, 1)) |>
filter(!is.na(GEOID)) |>
group_by(GEOID) |>
summarise(
state              = first(state),
county             = first(county),
n_records          = n(),
n_agencies         = n_distinct(agency),
n_tech_types       = n_distinct(technology),
raw_weighted_score = sum(weight, na.rm = TRUE),
.groups = "drop"
)
# ── Step 3: Rebuild analysis_df with the excluded-agency score ──
analysis_df_excl <- acs |>
left_join(atlas_county_excl |> st_drop_geometry() |> select(GEOID, n_records, n_agencies, n_tech_types, raw_weighted_score),
by = "GEOID") |>
mutate(
across(c(n_records, n_agencies, n_tech_types, raw_weighted_score), ~ replace_na(., 0)),
weighted_score_per100k = raw_weighted_score / total_pop * 100000
)
# Quick check: how many counties' scores actually changed?
score_comparison <- spatial_df |>
st_drop_geometry() |>
select(GEOID, weighted_score_per100k) |>
rename(score_with_all_agencies = weighted_score_per100k) |>
left_join(analysis_df_excl |> st_drop_geometry() |> select(GEOID, weighted_score_per100k),
by = "GEOID") |>
rename(score_excl_state_federal = weighted_score_per100k) |>
mutate(changed = score_with_all_agencies != score_excl_state_federal)
score_comparison |> count(changed)
# ── Step 4: Merge into the full modeling pipeline (crime, officers, controls) ──
spatial_df_excl <- analysis_df_excl |>
st_as_sf()
spatial_df_full_excl <- spatial_df_excl |>
filter(total_pop >= 2500) |>
left_join(crime_county_avg,    by = "GEOID") |>
left_join(officers_county_avg, by = "GEOID") |>
filter(!if_any(c(p_black, p_hisp, p_foreign, med_income, gini, log_pop_den,
med_home_val, p_renter, mean_violent_rate, mean_property_rate,
mean_officers_per_1000), is.na))
cat("Counties retained (excl. state/federal agencies):", nrow(spatial_df_full_excl), "\n")
# ── Step 5: Rebuild spatial weights on this exact filtered sample ──
weights_full_excl <- build_spatial_weights(spatial_df_full_excl)
# ── Step 6: Refit the final SAR model on the excluded-agency sample ──
sar_model_excl <- lagsarlm(
log1p(weighted_score_per100k) ~ p_black + p_hisp + p_foreign + med_income +
med_home_val + p_renter + gini + log_pop_den +
mean_violent_rate + mean_property_rate + mean_officers_per_1000,
data    = spatial_df_full_excl |> st_drop_geometry(),
listw   = weights_full_excl,
zero.policy = TRUE
)
summary(sar_model_excl)
moran.test(residuals(sar_model_excl), weights_full_excl, zero.policy = TRUE)
# ── Step 7: Compare directly against your final model ──
spatial_comparison_agency_check <- bind_rows(
extract_spatial_model_n(sar_model_final, "Final model (all agencies)"),
extract_spatial_model_n(sar_model_excl,  "Robustness (excl. state/federal agencies)")
) |>
mutate(
estimate_label = paste0(
signif(estimate, 3),
case_when(
p_value < 0.001 ~ "***",
p_value < 0.01  ~ "**",
p_value < 0.05  ~ "*",
TRUE ~ ""
)
)
) |>
select(model, n, term, estimate_label) |>
pivot_wider(names_from = model, values_from = estimate_label)
spatial_comparison_agency_check
extract_spatial_model_n <- function(model, label) {
s <- summary(model)
coefs <- as.data.frame(s$Coef)
coefs$term <- rownames(coefs)
n_obs <- length(residuals(model))   # compute FIRST, outside mutate()
coefs |>
rename(estimate = Estimate, std_error = `Std. Error`, p_value = `Pr(>|z|)`) |>
mutate(
model       = label,
n           = n_obs,            # just insert the pre-computed value
significant = p_value < 0.05
) |>
select(model, n, term, estimate, p_value, significant)
}
spatial_comparison_agency_check <- bind_rows(
extract_spatial_model_n(sar_model_final, "Final model (all agencies)"),
extract_spatial_model_n(sar_model_excl,  "Robustness (excl. state/federal agencies)")
) |>
mutate(
estimate_label = paste0(
signif(estimate, 3),
case_when(
p_value < 0.001 ~ "***",
p_value < 0.01  ~ "**",
p_value < 0.05  ~ "*",
TRUE ~ ""
)
)
) |>
select(model, n, term, estimate_label) |>
pivot_wider(names_from = model, values_from = estimate_label)
spatial_comparison_agency_check
ggsave("figures/surveillance_index_map.png", width = 10, height = 7, dpi = 300, bg = "white")
save_figure <- function(plot, filename, width = 10, height = 7, dpi = 300) {
if (!dir.exists("figures")) dir.create("figures")
ggsave(
filename = file.path("figures", filename),
plot     = plot,
width    = width,
height   = height,
dpi      = dpi,
bg       = "white"
)
cat("Saved:", file.path("figures", filename), "\n")
}
